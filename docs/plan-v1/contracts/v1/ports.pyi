from typing import Protocol
from .types import (
    Action, AuditResult, BudgetKind, BudgetRemaining, BudgetUsage, Command,
    ControlEvent, Decision, DecisionRequest, ErrorCode, JsonValue, Observation,
    Operation, Prediction, ProviderUsage, RunConfig, RunExport, RunSummary,
    Snapshot, State, StepReceipt, Task, TransitionResult, VerificationResult,
)

class PortError(Exception):
    code: ErrorCode
    message: str
    def __init__(self, code: ErrorCode, message: str) -> None: ...

class RuntimePort(Protocol):
    def transition(self, state: State, action: object, allowed_ops: list[Operation]) -> TransitionResult: ...

class VerifierPort(Protocol):
    def check(self, task: Task, state: State) -> VerificationResult: ...
    def audit_transition(self, action: object, allowed_ops: list[Operation], result: TransitionResult) -> AuditResult: ...

class StorePort(Protocol):
    def create_run(self, run_id: str, task: Task, branch_id: str) -> Observation: ...
    def observe(self, run_id: str, branch_id: str) -> Observation: ...
    def execute(self, command: Command, runtime: RuntimePort) -> StepReceipt: ...
    def create_snapshot(self, run_id: str, branch_id: str, snapshot_id: str) -> Snapshot: ...
    def fork(self, run_id: str, snapshot_id: str, branch_id: str) -> Observation: ...
    def usage(self, run_id: str) -> BudgetUsage: ...
    def remaining(self, run_id: str) -> BudgetRemaining: ...
    def reserve_budget(self, run_id: str, kind: BudgetKind, count: int) -> bool: ...
    def record_control(self, run_id: str, kind: str, payload: dict[str, JsonValue]) -> ControlEvent: ...
    def export_run(self, run_id: str) -> RunExport: ...
    def finish_run(self, run_id: str, summary: RunSummary) -> None: ...
    def close(self) -> None: ...

class DecisionPort(Protocol):
    def decide(self, request: DecisionRequest) -> Decision: ...
    def usage(self, request_id: str) -> ProviderUsage | None: ...

class WorldModelPort(Protocol):
    def predict(self, state: State, action: Action) -> Prediction: ...

class DecisionFactoryPort(Protocol):
    def build(self, config: RunConfig, runtime: RuntimePort, world_model: WorldModelPort | None) -> DecisionPort: ...

class TaskRepositoryPort(Protocol):
    def load(self, task_id: str) -> Task: ...
    def list_ids(self) -> list[str]: ...
    def dataset_digest(self) -> str: ...

class OrchestratorPort(Protocol):
    def run(self, config: RunConfig) -> RunSummary: ...

class EvaluationPort(Protocol):
    def evaluate(self, configs: list[RunConfig]) -> list[RunSummary]: ...
    def replay(self, exported: RunExport) -> AuditResult: ...
    def write_report(self, summaries: list[RunSummary], output_dir: str) -> list[str]: ...
