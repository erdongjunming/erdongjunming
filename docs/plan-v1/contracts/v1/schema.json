{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-program-world-lab:contracts:1.0.0",
  "$comment": "Use a $defs reference for each public object. Cross-field semantics are in 01-contract.md.",
  "$defs": {
    "Id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Index": {"type": "integer", "minimum": 0, "maximum": 3},
    "Value": {"type": "integer", "minimum": -8, "maximum": 8},
    "Operation": {"enum": ["SET", "ADD", "COPY", "SWAP"]},
    "ErrorCode": {"enum": ["malformed_action", "invalid_argument", "action_forbidden", "state_conflict", "idempotency_conflict", "budget_exhausted", "unknown_run", "unknown_branch", "unknown_snapshot", "run_exists", "run_closed", "branch_exists", "branch_limit", "snapshot_limit", "storage_error", "schema_mismatch", "provider_timeout", "provider_rate_limited", "provider_auth", "provider_unavailable", "provider_protocol", "prediction_unavailable", "audit_failed", "cancelled", "internal_error"]},
    "ErrorInfo": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"$ref": "#/$defs/ErrorCode"}, "message": {"type": "string", "maxLength": 2048}}},
    "State": {"type": "object", "additionalProperties": false, "required": ["env_version", "registers"], "properties": {"env_version": {"const": "reg4/1.0.0"}, "registers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/Value"}}}},
    "Action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "index", "value"], "properties": {"op": {"const": "SET"}, "index": {"$ref": "#/$defs/Index"}, "value": {"$ref": "#/$defs/Value"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "index", "delta"], "properties": {"op": {"const": "ADD"}, "index": {"$ref": "#/$defs/Index"}, "delta": {"type": "integer", "minimum": -2, "maximum": 2}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "source", "target"], "properties": {"op": {"const": "COPY"}, "source": {"$ref": "#/$defs/Index"}, "target": {"$ref": "#/$defs/Index"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "left", "right"], "properties": {"op": {"const": "SWAP"}, "left": {"$ref": "#/$defs/Index"}, "right": {"$ref": "#/$defs/Index"}}}
      ]
    },
    "Observation": {"type": "object", "additionalProperties": false, "required": ["branch_id", "revision", "state_id", "state"], "properties": {"branch_id": {"$ref": "#/$defs/Id"}, "revision": {"type": "integer", "minimum": 0}, "state_id": {"$ref": "#/$defs/Digest"}, "state": {"$ref": "#/$defs/State"}}},
    "Target": {"type": "object", "additionalProperties": false, "required": ["index", "value"], "properties": {"index": {"$ref": "#/$defs/Index"}, "value": {"$ref": "#/$defs/Value"}}},
    "Goal": {"type": "object", "additionalProperties": false, "required": ["targets", "preserve"], "properties": {"targets": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/Target"}}, "preserve": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/Index"}}}},
    "Task": {"type": "object", "additionalProperties": false, "required": ["schema_version", "task_id", "family", "initial", "goal", "allowed_ops", "max_attempts", "max_decisions", "max_proposals", "max_plan_evaluations", "seed"], "properties": {
      "schema_version": {"const": "1.0.0"}, "task_id": {"$ref": "#/$defs/Id"}, "family": {"enum": ["set", "add", "copy", "swap", "combined", "restricted"]}, "initial": {"$ref": "#/$defs/State"}, "goal": {"$ref": "#/$defs/Goal"}, "allowed_ops": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/Operation"}}, "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20}, "max_decisions": {"type": "integer", "minimum": 1, "maximum": 100}, "max_proposals": {"type": "integer", "minimum": 1, "maximum": 800}, "max_plan_evaluations": {"type": "integer", "minimum": 1, "maximum": 1000000}, "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    }},
    "TransitionResult": {"type": "object", "additionalProperties": false, "required": ["before", "after", "accepted", "error"], "properties": {"before": {"$ref": "#/$defs/State"}, "after": {"$ref": "#/$defs/State"}, "accepted": {"type": "boolean"}, "error": {"anyOf": [{"$ref": "#/$defs/ErrorInfo"}, {"type": "null"}]}}},
    "Command": {"type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "command_id", "branch_id", "expected_revision", "action"], "properties": {"schema_version": {"const": "1.0.0"}, "run_id": {"$ref": "#/$defs/Id"}, "command_id": {"$ref": "#/$defs/Id"}, "branch_id": {"$ref": "#/$defs/Id"}, "expected_revision": {"type": "integer", "minimum": 0}, "action": {"type": "object", "maxProperties": 8}}},
    "StepReceipt": {"type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "command_id", "disposition", "attempt_index", "before", "after", "error"], "properties": {"schema_version": {"const": "1.0.0"}, "run_id": {"$ref": "#/$defs/Id"}, "command_id": {"$ref": "#/$defs/Id"}, "disposition": {"enum": ["applied", "invalid", "rejected"]}, "attempt_index": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}, "before": {"$ref": "#/$defs/Observation"}, "after": {"$ref": "#/$defs/Observation"}, "error": {"anyOf": [{"$ref": "#/$defs/ErrorInfo"}, {"type": "null"}]}}},
    "Snapshot": {"type": "object", "additionalProperties": false, "required": ["schema_version", "snapshot_id", "run_id", "observation"], "properties": {"schema_version": {"const": "1.0.0"}, "snapshot_id": {"$ref": "#/$defs/Id"}, "run_id": {"$ref": "#/$defs/Id"}, "observation": {"$ref": "#/$defs/Observation"}}},
    "Violation": {"type": "object", "additionalProperties": false, "required": ["code", "index", "expected", "actual"], "properties": {"code": {"enum": ["target_mismatch", "preserve_violation"]}, "index": {"$ref": "#/$defs/Index"}, "expected": {"$ref": "#/$defs/Value"}, "actual": {"$ref": "#/$defs/Value"}}},
    "VerificationResult": {"type": "object", "additionalProperties": false, "required": ["schema_version", "task_id", "state_id", "success", "violations"], "properties": {"schema_version": {"const": "1.0.0"}, "task_id": {"$ref": "#/$defs/Id"}, "state_id": {"$ref": "#/$defs/Digest"}, "success": {"type": "boolean"}, "violations": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/Violation"}}}},
    "AuditResult": {"type": "object", "additionalProperties": false, "required": ["valid", "violations"], "properties": {"valid": {"type": "boolean"}, "violations": {"type": "array", "items": {"type": "string"}}}},
    "BudgetUsage": {"type": "object", "additionalProperties": false, "required": ["action_attempts", "decision_calls", "proposal_count", "exact_queries", "model_queries"], "properties": {"action_attempts": {"type": "integer", "minimum": 0}, "decision_calls": {"type": "integer", "minimum": 0}, "proposal_count": {"type": "integer", "minimum": 0}, "exact_queries": {"type": "integer", "minimum": 0}, "model_queries": {"type": "integer", "minimum": 0}}},
    "BudgetEvent": {"type": "object", "additionalProperties": false, "required": ["event_seq", "kind", "count"], "properties": {"event_seq": {"type": "integer", "minimum": 1}, "kind": {"enum": ["action_attempts", "decision_calls", "proposal_count", "exact_queries", "model_queries"]}, "count": {"type": "integer", "minimum": 1}}},
    "BudgetRemaining": {"type": "object", "additionalProperties": false, "required": ["attempts", "decisions", "proposals", "plan_evaluations"], "properties": {"attempts": {"type": "integer", "minimum": 0}, "decisions": {"type": "integer", "minimum": 0}, "proposals": {"type": "integer", "minimum": 0}, "plan_evaluations": {"type": "integer", "minimum": 0}}},
    "Candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "actions", "source", "prediction_kind", "predicted_states", "confidence"], "properties": {"candidate_id": {"$ref": "#/$defs/Id"}, "actions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/Action"}}, "source": {"enum": ["random", "heuristic", "exact_search", "llm", "world_model"]}, "prediction_kind": {"enum": ["none", "exact", "learned"]}, "predicted_states": {"anyOf": [{"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/State"}}, {"type": "null"}]}, "confidence": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]}}},
    "DecisionRequest": {"type": "object", "additionalProperties": false, "required": ["schema_version", "request_id", "task", "observation", "budget", "history"], "properties": {"schema_version": {"const": "1.0.0"}, "request_id": {"$ref": "#/$defs/Id"}, "task": {"$ref": "#/$defs/Task"}, "observation": {"$ref": "#/$defs/Observation"}, "budget": {"$ref": "#/$defs/BudgetRemaining"}, "history": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/StepReceipt"}}}},
    "Decision": {"type": "object", "additionalProperties": false, "required": ["schema_version", "request_id", "status", "candidates", "error"], "properties": {"schema_version": {"const": "1.0.0"}, "request_id": {"$ref": "#/$defs/Id"}, "status": {"enum": ["candidates", "stop", "error"]}, "candidates": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/Candidate"}}, "error": {"anyOf": [{"$ref": "#/$defs/ErrorInfo"}, {"type": "null"}]}}},
    "Prediction": {"type": "object", "additionalProperties": false, "required": ["schema_version", "model_id", "model_version", "env_version", "state_id", "action", "status", "next_state", "confidence", "error"], "properties": {"schema_version": {"const": "1.0.0"}, "model_id": {"$ref": "#/$defs/Id"}, "model_version": {"$ref": "#/$defs/Id"}, "env_version": {"const": "reg4/1.0.0"}, "state_id": {"$ref": "#/$defs/Digest"}, "action": {"$ref": "#/$defs/Action"}, "status": {"enum": ["predicted", "abstain"]}, "next_state": {"anyOf": [{"$ref": "#/$defs/State"}, {"type": "null"}]}, "confidence": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]}, "error": {"anyOf": [{"$ref": "#/$defs/ErrorInfo"}, {"type": "null"}]}}},
    "ProviderUsage": {"type": "object", "additionalProperties": false, "required": ["provider_calls", "input_tokens", "output_tokens", "provider_ms", "cost_amount", "cost_currency"], "properties": {"provider_calls": {"type": "integer", "minimum": 0}, "input_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "output_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "provider_ms": {"type": "number", "minimum": 0}, "cost_amount": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "cost_currency": {"anyOf": [{"enum": ["USD", "CNY"]}, {"type": "null"}]}}},
    "RunConfig": {"type": "object", "additionalProperties": false, "required": ["run_id", "task", "planner_name", "run_timeout_ms", "provider_timeout_ms", "max_provider_calls", "max_api_cost", "cost_currency"], "properties": {"run_id": {"$ref": "#/$defs/Id"}, "task": {"$ref": "#/$defs/Task"}, "planner_name": {"$ref": "#/$defs/Id"}, "run_timeout_ms": {"type": "integer", "minimum": 1}, "provider_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "max_provider_calls": {"type": "integer", "minimum": 0}, "max_api_cost": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "cost_currency": {"anyOf": [{"enum": ["USD", "CNY"]}, {"type": "null"}]}}},
    "Metrics": {"type": "object", "additionalProperties": false, "required": ["action_attempts", "applied_actions", "invalid_actions", "decision_calls", "proposal_count", "exact_queries", "model_queries", "cache_hits", "provider_calls", "input_tokens", "output_tokens", "wall_ms", "provider_ms", "cost_amount", "cost_currency"], "properties": {
      "action_attempts": {"type": "integer", "minimum": 0}, "applied_actions": {"type": "integer", "minimum": 0}, "invalid_actions": {"type": "integer", "minimum": 0}, "decision_calls": {"type": "integer", "minimum": 0}, "proposal_count": {"type": "integer", "minimum": 0}, "exact_queries": {"type": "integer", "minimum": 0}, "model_queries": {"type": "integer", "minimum": 0}, "cache_hits": {"type": "integer", "minimum": 0}, "provider_calls": {"type": "integer", "minimum": 0}, "input_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "output_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "wall_ms": {"type": "number", "minimum": 0}, "provider_ms": {"type": "number", "minimum": 0}, "cost_amount": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "cost_currency": {"anyOf": [{"enum": ["USD", "CNY"]}, {"type": "null"}]}
    }},
    "Provenance": {"type": "object", "additionalProperties": false, "required": ["git_commit", "contract_digest", "task_set_digest", "env_version", "seed", "provider", "model", "config_digest"], "properties": {"git_commit": {"type": "string", "pattern": "^([0-9a-f]{40}|uncommitted)$"}, "contract_digest": {"$ref": "#/$defs/Digest"}, "task_set_digest": {"$ref": "#/$defs/Digest"}, "env_version": {"const": "reg4/1.0.0"}, "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "provider": {"anyOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]}, "model": {"anyOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]}, "config_digest": {"$ref": "#/$defs/Digest"}}},
    "RunSummary": {"type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "task_id", "status", "final_observation", "final_verification", "metrics", "provenance"], "properties": {"schema_version": {"const": "1.0.0"}, "run_id": {"$ref": "#/$defs/Id"}, "task_id": {"$ref": "#/$defs/Id"}, "status": {"enum": ["success", "failed", "exhausted", "provider_error", "cancelled", "audit_failed"]}, "final_observation": {"$ref": "#/$defs/Observation"}, "final_verification": {"$ref": "#/$defs/VerificationResult"}, "metrics": {"$ref": "#/$defs/Metrics"}, "provenance": {"$ref": "#/$defs/Provenance"}}},
    "BranchRecord": {"type": "object", "additionalProperties": false, "required": ["branch_id", "parent_snapshot_id", "latest"], "properties": {"branch_id": {"$ref": "#/$defs/Id"}, "parent_snapshot_id": {"anyOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]}, "latest": {"$ref": "#/$defs/Observation"}}},
    "ControlEvent": {"type": "object", "additionalProperties": false, "required": ["event_seq", "kind", "payload"], "properties": {"event_seq": {"type": "integer", "minimum": 1}, "kind": {"enum": ["snapshot_created", "branch_created", "branch_selected", "decision_recorded", "provider_usage", "run_finished", "run_cancelled"]}, "payload": {"type": "object"}}},
    "RunExport": {"type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "task", "initial_branch_id", "branches", "snapshots", "commands", "receipts", "budget", "budget_events", "control_events", "final_summary"], "properties": {"schema_version": {"const": "1.0.0"}, "run_id": {"$ref": "#/$defs/Id"}, "task": {"$ref": "#/$defs/Task"}, "initial_branch_id": {"$ref": "#/$defs/Id"}, "branches": {"type": "array", "items": {"$ref": "#/$defs/BranchRecord"}}, "snapshots": {"type": "array", "items": {"$ref": "#/$defs/Snapshot"}}, "commands": {"type": "array", "items": {"$ref": "#/$defs/Command"}}, "receipts": {"type": "array", "items": {"$ref": "#/$defs/StepReceipt"}}, "budget": {"$ref": "#/$defs/BudgetUsage"}, "budget_events": {"type": "array", "items": {"$ref": "#/$defs/BudgetEvent"}}, "control_events": {"type": "array", "items": {"$ref": "#/$defs/ControlEvent"}}, "final_summary": {"anyOf": [{"$ref": "#/$defs/RunSummary"}, {"type": "null"}]}}}
  }
}
